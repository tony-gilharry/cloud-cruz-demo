<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Rejected_Needs_Reason</fullName>
  <active>true</active>
  <description>Every rejection explains itself to the partner.</description>
  <errorDisplayField>Rejection_Reason__c</errorDisplayField>
  <errorConditionFormula>AND(ISPICKVAL(Status__c,"Rejected"), ISBLANK(Rejection_Reason__c))</errorConditionFormula>
  <errorMessage>Add a rejection reason.</errorMessage>
</ValidationRule>
