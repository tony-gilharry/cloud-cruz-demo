{
  "name": "cloud-cruz-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Partner operations systems for Cloud Cruz's Ecosystem Partner Program, a fictional vendor on synthetic data.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:reset": "node --env-file-if-exists=.env.local foundation/db/run.ts reset",
    "db:seed": "node --env-file-if-exists=.env.local foundation/db/run.ts seed",
    "db:preview": "node foundation/db/run.ts preview",
    "db:verify": "node --env-file-if-exists=.env.local foundation/verify.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
