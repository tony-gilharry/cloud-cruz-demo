# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
# In production these live in Vercel and Supabase environment settings.

# Admin connection, used only by the seed and reset scripts (npm run db:reset).
# Supabase dashboard > Connect > Session pooler. Do not add ?sslmode to the URL;
# TLS is configured in foundation/db/client.ts.
DATABASE_URL=postgresql://postgres.<project-ref>:<admin-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Read-only connection for AI-generated SQL (Build 2 onward). Set it before the first db:reset. Same host, but the
# user is the ecosystem_readonly role. Pick any strong password here: db:reset
# sets the role's password from this URL, so it never appears in SQL files.
READONLY_DATABASE_URL=postgresql://ecosystem_readonly.<project-ref>:<readonly-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Path to the Supabase CA certificate, so TLS verifies the server.
# Supabase dashboard > Database > Settings > SSL Configuration > Download certificate.
DATABASE_CA_CERT=./supabase-ca.crt
